MYSQL_DATABASE=fresh_fruit
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
DB_URL=jdbc:mysql://localhost:3306/fresh_fruit?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=replace_with_database_password
JWT_SECRET=replace_with_base64_secret_from_openssl
JWT_EXPIRATION_MINUTES=120
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace_with_admin_password_at_least_12_chars
# 商品图片本地持久化目录
PRODUCT_IMAGE_STORAGE_DIR=./uploads/products
# 在线AI可选；无Key仍可启动基础咨询。主密钥使用 openssl rand -base64 32 生成。
AI_CONFIG_ENCRYPTION_KEY=
AI_ALLOWED_HOSTS=*.maas.aliyuncs.com,dashscope.aliyuncs.com,api.openai.com,api.deepseek.com
AI_ALLOW_LOCAL_ENDPOINTS=false
AI_JOBS_ENABLED=true
